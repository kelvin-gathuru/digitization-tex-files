    <stackversion>
      <text>2025073100</text>
    </stackversion>
    <questionvariables>
      <text>lambda: rand(4)+3; /* 3 to 6 */
k: rand(4)+1; /* 1 to 4 */
ta1: float(pdf_poisson(k, lambda));
</text>
