<quiz>

  <!-- Essay -->
  <question type="essay">
    <name>
      <text>Preparing Plant Fibers</text>
    </name>

    <questiontext format="html">
      <text><![CDATA[
<p><strong>Describe the general steps involved in preparing a plant fiber from raw plant material for use in construction composites.</strong></p>
]]></text>
    </questiontext>

    <defaultgrade>10</defaultgrade>
    <responseformat>editor</responseformat>
    <responserequired>1</responserequired>
    <responsefieldlines>12</responsefieldlines>
    <attachments>0</attachments>
    <attachmentsrequired>0</attachmentsrequired>

    <generalfeedback format="html">
      <text><![CDATA[
<p><strong>Expected Answer:</strong></p>

<ul>
<li>Harvest the plant material.</li>
<li>Extract the fibers (retting, decortication or mechanical extraction).</li>
<li>Clean and wash the fibers.</li>
<li>Dry the fibers.</li>
<li>Apply chemical or physical treatment if required.</li>
<li>Cut and prepare fibers for composite manufacturing.</li>
</ul>
]]></text>
    </generalfeedback>
  </question>

