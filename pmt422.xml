<!-- Question 10 -->
<question type="numerical">
  <name>
    <text>Percentage Excess Air Calculation</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[
      <p>A combustion system has:</p>

      <ul>
        <li>Stoichiometric AFR = 14.5</li>
        <li>Actual AFR = 17.4</li>
      </ul>

      <p>Calculate the <strong>percentage excess air</strong>.</p>

      <p>Use the formula:</p>

      <p>
        <strong>Percentage Excess Air = ((Actual AFR - Stoichiometric AFR) / Stoichiometric AFR) × 100</strong>
      </p>

      <p>Enter your answer as a percentage value.</p>
    ]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[
      <p>Percentage Excess Air = ((17.4 - 14.5) / 14.5) × 100</p>
      <p>= (2.9 / 14.5) × 100</p>
      <p>= 20%</p>
      <p>Therefore, the percentage excess air is <strong>20%</strong>.</p>
    ]]></text>
  </generalfeedback>
  <defaultgrade>1.0000000</defaultgrade>
  <penalty>0.3333333</penalty>
  <hidden>0</hidden>

  <answer fraction="100">
    <text>20</text>
    <tolerance>0.01</tolerance>
    <feedback format="html">
      <text><![CDATA[Correct. The percentage excess air is 20%.]]></text>
    </feedback>
  </answer>
</question>

