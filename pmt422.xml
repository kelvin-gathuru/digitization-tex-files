<!-- Question 7 -->
<question type="numerical">
  <name>
    <text>Oxygen Percentage Calculation</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[
      <p>A fuel has the following ultimate analysis:</p>
      <ul>
        <li>Carbon = 80%</li>
        <li>Hydrogen = 10%</li>
        <li>Sulfur = 2%</li>
        <li>Nitrogen = 3%</li>
      </ul>

      <p>Calculate the <strong>oxygen percentage</strong>.</p>

      <p>Use the formula:</p>

      <p>
        <strong>O = 100 - (C + H + S + N)</strong>
      </p>

      <p>Enter your answer as a percentage value.</p>
    ]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[
      <p>O = 100 - (80 + 10 + 2 + 3)</p>
      <p>O = 100 - 95 = 5%</p>
      <p>Therefore, the oxygen content is <strong>5%</strong>.</p>
    ]]></text>
  </generalfeedback>
  <defaultgrade>1.0000000</defaultgrade>
  <penalty>0.3333333</penalty>
  <hidden>0</hidden>

  <answer fraction="100">
    <text>5</text>
    <tolerance>0</tolerance>
    <feedback format="html">
      <text><![CDATA[Correct. The oxygen percentage is 5%.]]></text>
    </feedback>
  </answer>
</question>


