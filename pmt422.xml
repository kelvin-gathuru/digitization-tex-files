<!-- Question 3 -->
<question type="multichoice">
  <name>
    <text>HCV and LCV</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[
      <p>What is the main difference between <strong>Higher Calorific Value (HCV)</strong> and <strong>Lower Calorific Value (LCV)</strong>?</p>
    ]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[
      <p>HCV includes the latent heat of condensation of water vapor, while LCV excludes it.</p>
    ]]></text>
  </questiontext>
  <defaultgrade>1.0000000</defaultgrade>
  <penalty>0.3333333</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>true</shuffleanswers>
  <answernumbering>ABCD</answernumbering>

  <answer fraction="0" format="html">
    <text><![CDATA[A. HCV excludes latent heat of water vapor]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[B. LCV includes latent heat of water vapor]]></text>
  </answer>
  <answer fraction="100" format="html">
    <text><![CDATA[C. HCV includes latent heat of water vapor while LCV excludes it]]></text>
    <feedback format="html">
      <text><![CDATA[Correct. HCV accounts for the latent heat recovered when water vapor condenses, while LCV does not.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[D. There is no difference]]></text>
  </answer>
</question>


<!-- Question 4 -->
<question type="numerical">
  <name>
    <text>Fixed Carbon Calculation</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[
      <p>A coal sample has the following proximate analysis:</p>
      <ul>
        <li>Moisture = 8%</li>
        <li>Volatile matter = 30%</li>
        <li>Ash = 12%</li>
      </ul>

      <p>Calculate the <strong>fixed carbon percentage</strong>.</p>

      <p>Use the formula:</p>

      <p>
        <strong>FC = 100 - (M + VM + A)</strong>
      </p>

      <p>Enter your answer as a percentage value.</p>
    ]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[
      <p>FC = 100 - (8 + 30 + 12) = 50%.</p>
      <p>Therefore, the fixed carbon content is <strong>50%</strong>.</p>
    ]]></text>
  </generalfeedback>
  <defaultgrade>1.0000000</defaultgrade>
  <penalty>0.3333333</penalty>
  <hidden>0</hidden>

  <answer fraction="100">
    <text>50</text>
    <tolerance>0</tolerance>
    <feedback format="html">
      <text><![CDATA[Correct. The fixed carbon percentage is 50%.]]></text>
    </feedback>
  </answer>
</question>


