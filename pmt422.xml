<quiz>

<!-- Question 1 -->
<question type="multichoice">
  <name>
    <text>Definition of a Fuel</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[
      <p>Which of the following best defines a <strong>fuel</strong>?</p>
    ]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[
      <p>A fuel is a combustible substance that releases heat energy during combustion with oxygen.</p>
    ]]></text>
  </generalfeedback>
  <defaultgrade>1.0000000</defaultgrade>
  <penalty>0.3333333</penalty>
  <hidden>0</hidden>
  <single>true</single>
  <shuffleanswers>true</shuffleanswers>
  <answernumbering>ABCD</answernumbering>

  <answer fraction="0" format="html">
    <text><![CDATA[A. A substance used only for generating electricity]]></text>
  </answer>
  <answer fraction="100" format="html">
    <text><![CDATA[B. A combustible substance that releases heat when it reacts with oxygen]]></text>
    <feedback format="html">
      <text><![CDATA[Correct. A fuel releases heat energy during combustion with oxygen.]]></text>
    </feedback>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[C. Any chemical compound found in nature]]></text>
  </answer>
  <answer fraction="0" format="html">
    <text><![CDATA[D. A material used only in engines]]></text>
  </answer>
</question>


