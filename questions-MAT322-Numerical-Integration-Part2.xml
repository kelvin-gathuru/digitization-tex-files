      <text>2025073100</text>
    </stackversion>
    <questionvariables>
      <text>S1: float(rand(100)/10 + 1);
diff: float(rand(10)/1000 + 0.001);
S2: S1 + diff;
ta1: abs(S2 - S1) / 15;
</text>
