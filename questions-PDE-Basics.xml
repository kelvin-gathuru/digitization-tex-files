  <question type="stack">
    <name><text>PDE Basics - Q1: IC vs BC (Time)</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>Determine whether the following condition is an <strong>initial condition</strong> or a <strong>boundary condition</strong>:</p>
<p>\[ u(x, {@t0@}) = {@expr@} \]</p>
<p>The condition is: [[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</p>]]></text>
    </questiontext>
